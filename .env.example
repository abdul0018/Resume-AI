# Port the server listens on
PORT=3000

# Public URL of the site (used in social previews and share links), e.g. https://visol.uz
APP_URL=

# Admin panel password (required in production) — open /admin
ADMIN_PASSWORD=

# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Where the SQLite database and uploaded files are stored
DATA_DIR=./data

# Optional: Telegram notifications about new orders, receipts and RSVPs
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
