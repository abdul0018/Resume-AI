  "components": [
    {
      "name": "Gold Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action: map link, RSVP submit. Gilded pill.",
      "html": "<div class=\"ds-mh\"><button class=\"ds-mh-btn\">Javobni yuborish</button></div>",
      "css": ".ds-mh{--mh-ground:#f6eee1;--mh-ink:#4a331b;--mh-ink-soft:#77604a;--mh-gold-deep:#8f6a2a;--mh-gold:#b08636;--mh-gold-pale:#efd9a0;--mh-line:rgba(176,134,54,0.38);font-family:\"Bodoni Moda\",\"Didot\",\"Bodoni 72\",Georgia,serif;font-optical-sizing:auto;color:var(--mh-ink);background:var(--mh-ground);padding:24px;text-align:center;}.ds-mh-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 22px;border:0;border-radius:999px;font:500 15px/1 \"Bodoni Moda\",Georgia,serif;letter-spacing:.02em;color:#3f2a12;background:linear-gradient(170deg,#f8e4ad,#dcb466 60%,#c59a4a);box-shadow:inset 0 1px 0 rgba(255,255,255,.65),inset 0 0 0 1px rgba(143,106,42,.45),0 10px 20px -12px rgba(120,84,30,.7);transition:transform .25s cubic-bezier(.16,1,.3,1),box-shadow .25s;cursor:pointer}.ds-mh-btn:hover{box-shadow:inset 0 1px 0 rgba(255,255,255,.75),inset 0 0 0 1px rgba(143,106,42,.55),0 14px 26px -12px rgba(120,84,30,.75)}.ds-mh-btn:active{transform:scale(.97)}.ds-mh-btn:focus-visible{outline:2px solid #8f6a2a;outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action beside a gold button; also the showcase replay control.",
      "html": "<div class=\"ds-mh\"><button class=\"ds-mh-ghost\">Yandex xarita</button></div>",
      "css": ".ds-mh{--mh-ground:#f6eee1;--mh-ink:#4a331b;--mh-ink-soft:#77604a;--mh-gold-deep:#8f6a2a;--mh-gold:#b08636;--mh-gold-pale:#efd9a0;--mh-line:rgba(176,134,54,0.38);font-family:\"Bodoni Moda\",\"Didot\",\"Bodoni 72\",Georgia,serif;font-optical-sizing:auto;color:var(--mh-ink);background:var(--mh-ground);padding:24px;text-align:center;}.ds-mh-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:50px;padding:0 20px;border:0;border-radius:999px;font:15px/1 \"Bodoni Moda\",Georgia,serif;color:#4a331b;background:rgba(255,252,244,.5);box-shadow:inset 0 0 0 1px rgba(176,134,54,.38);cursor:pointer;transition:box-shadow .25s}.ds-mh-ghost:hover{box-shadow:inset 0 0 0 1px #b08636}.ds-mh-ghost:focus-visible{outline:2px solid #8f6a2a;outline-offset:3px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "RSVP text input on card stock with a gilt hairline.",
      "html": "<div class=\"ds-mh\" style=\"text-align:left\"><label class=\"ds-mh-label\" for=\"ds-n\">Ism va familiyangiz</label><input id=\"ds-n\" class=\"ds-mh-field\" placeholder=\"Ismingiz\"></div>",
      "css": ".ds-mh{--mh-ground:#f6eee1;--mh-ink:#4a331b;--mh-ink-soft:#77604a;--mh-gold-deep:#8f6a2a;--mh-gold:#b08636;--mh-gold-pale:#efd9a0;--mh-line:rgba(176,134,54,0.38);font-family:\"Bodoni Moda\",\"Didot\",\"Bodoni 72\",Georgia,serif;font-optical-sizing:auto;color:var(--mh-ink);background:var(--mh-ground);padding:24px;text-align:center;}.ds-mh-label{display:block;margin-bottom:8px;font-size:14px;color:#77604a}.ds-mh-field{display:block;width:100%;box-sizing:border-box;min-height:52px;padding:14px 16px;border-radius:14px;border:1px solid rgba(176,134,54,.38);background:#fffcf5;color:#4a331b;font:16px \"Bodoni Moda\",Georgia,serif;caret-color:#8f6a2a;appearance:none}.ds-mh-field::placeholder{color:#8f7a63}.ds-mh-field:focus{outline:none;border-color:#b08636;box-shadow:0 0 0 4px rgba(239,217,160,.45)}"
    },
    {
      "name": "Choice Pair",
      "kind": "chip",
      "refersTo": "choice",
      "description": "Attending / not attending toggles; the pressed one turns gold.",
      "html": "<div class=\"ds-mh\"><div class=\"ds-mh-pair\"><button class=\"ds-mh-choice\" aria-pressed=\"true\">Albatta kelaman</button><button class=\"ds-mh-choice\" aria-pressed=\"false\">Kela olmayman</button></div></div>",
      "css": ".ds-mh{--mh-ground:#f6eee1;--mh-ink:#4a331b;--mh-ink-soft:#77604a;--mh-gold-deep:#8f6a2a;--mh-gold:#b08636;--mh-gold-pale:#efd9a0;--mh-line:rgba(176,134,54,0.38);font-family:\"Bodoni Moda\",\"Didot\",\"Bodoni 72\",Georgia,serif;font-optical-sizing:auto;color:var(--mh-ink);background:var(--mh-ground);padding:24px;text-align:center;}.ds-mh-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ds-mh-choice{min-height:52px;border-radius:14px;border:1px solid rgba(176,134,54,.38);background:#fffcf5;font:15.5px \"Bodoni Moda\",Georgia,serif;color:#4a331b;cursor:pointer;transition:background .25s,color .25s,border-color .25s}.ds-mh-choice[aria-pressed=\"true\"]{background:linear-gradient(170deg,#f8e4ad,#dcb466);border-color:#b08636;color:#3f2a12}.ds-mh-choice:focus-visible{outline:2px solid #8f6a2a;outline-offset:3px}"
    },
    {
      "name": "Countdown Tiles",
      "kind": "card",
      "refersTo": "countdown-tile",
      "description": "Four gold tiles counting to the wedding.",
      "html": "<div class=\"ds-mh\"><div class=\"ds-mh-tiles\"><div class=\"ds-mh-tile\"><b>42</b><small>kun</small></div><div class=\"ds-mh-tile\"><b>07</b><small>soat</small></div><div class=\"ds-mh-tile\"><b>15</b><small>daqiqa</small></div><div class=\"ds-mh-tile\"><b>30</b><small>soniya</small></div></div></div>",
      "css": ".ds-mh{--mh-ground:#f6eee1;--mh-ink:#4a331b;--mh-ink-soft:#77604a;--mh-gold-deep:#8f6a2a;--mh-gold:#b08636;--mh-gold-pale:#efd9a0;--mh-line:rgba(176,134,54,0.38);font-family:\"Bodoni Moda\",\"Didot\",\"Bodoni 72\",Georgia,serif;font-optical-sizing:auto;color:var(--mh-ink);background:var(--mh-ground);padding:24px;text-align:center;}.ds-mh-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;max-width:360px;margin:0 auto}.ds-mh-tile{border-radius:14px;padding:14px 4px 11px;background:linear-gradient(165deg,#fbefcf,#ebcd8c 70%,#dcb46a);box-shadow:inset 0 1px 0 rgba(255,255,255,.7),inset 0 0 0 1px rgba(176,134,54,.35),0 10px 22px -14px rgba(120,84,30,.6)}.ds-mh-tile b{display:block;font-size:32px;line-height:1;font-weight:500;font-variant-numeric:tabular-nums lining-nums}.ds-mh-tile small{display:block;margin-top:6px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#6a4f2c}"
    },
    {
      "name": "Section Head with Gilt Rule",
      "kind": "custom",
      "refersTo": "",
      "description": "Headline, gilt star rule and body message: the core section rhythm.",
      "html": "<div class=\"ds-mh\"><h2 class=\"ds-mh-h\">Assalomu alaykum,<br>qadrli mehmon!</h2><div class=\"ds-mh-rule\"><i></i><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\"><path d=\"M8 0 L9.6 6.4 L16 8 L9.6 9.6 L8 16 L6.4 9.6 L0 8 L6.4 6.4Z\" fill=\"currentColor\"/></svg><i></i></div><p class=\"ds-mh-p\">Farzandlarimizning nikoh to‘yiga bag‘ishlangan bazmimizga sizni taklif etamiz.</p></div>",
      "css": ".ds-mh{--mh-ground:#f6eee1;--mh-ink:#4a331b;--mh-ink-soft:#77604a;--mh-gold-deep:#8f6a2a;--mh-gold:#b08636;--mh-gold-pale:#efd9a0;--mh-line:rgba(176,134,54,0.38);font-family:\"Bodoni Moda\",\"Didot\",\"Bodoni 72\",Georgia,serif;font-optical-sizing:auto;color:var(--mh-ink);background:var(--mh-ground);padding:24px;text-align:center;}.ds-mh-h{font-size:30px;line-height:1.12;font-weight:500;letter-spacing:-.005em;margin:0;text-wrap:balance}.ds-mh-rule{display:flex;align-items:center;justify-content:center;gap:10px;color:#b08636;margin:26px 0}.ds-mh-rule i{width:54px;height:1px;background:linear-gradient(90deg,transparent,currentColor)}.ds-mh-rule i:last-child{background:linear-gradient(270deg,transparent,currentColor)}.ds-mh-p{font-size:18px;line-height:1.62;margin:0;text-wrap:pretty}"
    },
    {
      "name": "Save the Date",
      "kind": "custom",
      "refersTo": "",
      "description": "Month and year flanking the gold-deep day numeral between gilt hairlines.",
      "html": "<div class=\"ds-mh\"><div class=\"ds-mh-bd\"><span>iyun</span><strong>19</strong><span>2027</span></div><p class=\"ds-mh-it\">Shanba, soat 18:00</p></div>",
